# Clima-Zap — single env template (Docker Compose + backend).
# Copy to .env (same dir as docker-compose.yml) and edit.
#
# Used by:
#   - Docker Compose (${VAR} interpolation / env_file)
#   - Backend pydantic-settings (loads this file from repo root, works from backend/ too)
#
# NOTE: no Cloudflare Workers este arquivo NÃO é usado — as mesmas variáveis
# viram `vars`/secrets do wrangler (backend/wrangler.jsonc + `wrangler secret put`,
# nomes em CAIXA ALTA, ex.: EVOLUTION_API_KEY). Veja README "Backend no
# Cloudflare Workers".

# --- Application ---
PORT=8000
ENVIRONMENT=development
DEFAULT_CITY="Triângulo, Juazeiro do Norte"
DEFAULT_LATITUDE=-7.229711
DEFAULT_LONGITUDE=-39.3300014
OPEN_METEO_URL="https://api.open-meteo.com/v1/forecast"
# Local/hybrid: http://localhost:8080
# Docker Compose overrides to http://evolution-api:8080 automatically.
# No Workers (produção) precisa ser um endpoint PÚBLICO HTTPS — o Worker
# manda a API key para lá e não alcança localhost.
EVOLUTION_API_URL="http://localhost:8080"
# Empty = docs resolved relative to repo (dev) or /docs (Docker sets this).
DOCS_DIR=
# Origens liberadas no CORS, separadas por vírgula (frontend na Vercel).
# Vazio = nenhuma origem cross-origin. `*` é ignorado de propósito.
CORS_ORIGINS=

# --- Evolution API (WhatsApp) ---
# TROQUE antes de qualquer uso real (produção avisa no startup se ficar no
# placeholder). Sugestão: `openssl rand -hex 32`.
EVOLUTION_API_KEY=troque-esta-chave
EVOLUTION_INSTANCE_NAME=clima-zap
# Número do próprio bot (só dígitos) — ativa a menção nativa do WhatsApp
# (@número) como invocação de comando na gramática.
TARGET_PHONE_NUMBER=
# Nome do bot na invocação textual: "@clima-zap previsao".
BOT_NAME=clima-zap
# Boletim periódico WhatsApp (grupo) — 3x/dia, jitter 0-15min.
# Vazio = boletim só para os grupos inscritos com /inscrever. Formato: 120363...@g.us
# Pegue o JID nos logs do webhook (remoteJid termina em @g.us).
FORECAST_GROUP_JID=
# Segurança do webhook: POST /api/v1/webhook exige
# `Authorization: Bearer <token>` (configure como header customizado no
# webhook da instância da Evolution API). OBRIGATÓRIO em produção: sem o
# token o endpoint responde 503 (fail closed) em vez de aceitar eventos
# forjados. Vazio = sem verificação apenas em desenvolvimento.
WEBHOOK_AUTH_TOKEN=

# --- Administração (/admin) ---
# Senha do comando /admin (só funciona no privado). Vazio = desabilitado.
# Gere com: openssl rand -hex 16
# No Workers: npx wrangler secret put ADMIN_PASSWORD
ADMIN_PASSWORD=
# Opcional: número do WhatsApp (só dígitos, com DDI) autorizado a usar /admin.
# Vazio = qualquer conversa privada que saiba a senha.
ADMIN_PHONE=

# --- Postgres (Evolution API) ---
POSTGRES_DATABASE=evolution
POSTGRES_USERNAME=evolution
# TROQUE antes de qualquer uso real.
POSTGRES_PASSWORD=troque-esta-senha

# Optional application DB URL (masked by backend settings); blank/unset uses
# local SQLite. Docker Compose otherwise points the backend at the Postgres service.
# For managed PostgreSQL, use postgresql+asyncpg://... and enable TLS as required.
# DATABASE_URL=
# Set true for managed PostgreSQL providers that require TLS.
DATABASE_SSL=false
