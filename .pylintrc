[MAIN]
source-roots=backend
# Artefatos do bundle Cloudflare Workers (pywrangler sync / wrangler dev)
ignore=python_modules,.venv-workers,.wrangler,pylock.toml

[TYPECHECK]
generated-members=alembic.context.*

[MESSAGES CONTROL]
disable=missing-module-docstring,missing-function-docstring,missing-class-docstring,missing-final-newline,line-too-long,trailing-whitespace,invalid-name,too-few-public-methods,wrong-import-order,import-outside-toplevel,logging-fstring-interpolation