PORT=8000
ENVIRONMENT=development
DEFAULT_CITY="Juazeiro do Norte"
DEFAULT_LATITUDE=-7.2128
DEFAULT_LONGITUDE=-39.3151
OPEN_METEO_URL="https://api.open-meteo.com/v1/forecast"

# Evolution API (WhatsApp)
# In dev (docker compose), keep http://evolution-api:8080 as internal name.
# When running backend locally outside Docker, use http://localhost:8080.
EVOLUTION_API_URL="http://evolution-api:8080"
EVOLUTION_API_KEY="changeme"
EVOLUTION_INSTANCE_NAME="clima-zap"
TARGET_PHONE_NUMBER=""
# Grupo WhatsApp que recebe o boletim periódico (3x/dia, jitter 0-15min).
# Vazio = jobs de forecast periódico desativados.
# Pegue o JID nos logs do webhook (remoteJid termina em @g.us).
FORECAST_GROUP_JID=""