{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "clima-zap-api",
	"main": "worker.py",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"python_workers"
	],
	// America/Fortaleza = UTC-3 (sem DST desde 2019).
	// Alertas  06/08/12/14/16/18h BRT → 09/11/15/17/19/21h UTC.
	// Boletins 06/14/20h BRT         → 09/17/23h UTC.
	// Sessão administrativa: verifica vencimentos a cada 5min.
	// (Espelhado em app/core/schedule.py — test_schedule.py garante o match.)
	"triggers": {
		"crons": [
			"0 9,11,15,17,19,21 * * *",
			"0 9,17,23 * * *",
			"*/5 * * * *",
			"* * * * *"
		]
	},
	// Binding único do D1 (env.DB) — lido em app/core/worker_runtime.d1().
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "clima-zap",
			"database_id": "f68189c5-9d04-4753-9441-f23a8835da7b",
			"migrations_dir": "migrations"
		}
	],
	// Docs markdown (docs/whatsapp-integration.md, docs/docker-setup.md)
	// servidos nos endpoints /docs/* via env.ASSETS.
	"assets": {
		"directory": "../docs",
		"binding": "ASSETS"
	},
	// Vars não-secretas.
	"vars": {
		"ENVIRONMENT": "production",
		"BOT_NAME": "clima-zap"
		// Origens do frontend para o CORS (separadas por vírgula).
		// Vazio = nenhuma origem cross-origin; `*` é ignorado.
		// "CORS_ORIGINS": "https://clima-zap.vercel.app"
	},
	// Segredos vão em `wrangler secret put <NOME>` (nunca no repositório):
	//   EVOLUTION_API_URL   → endpoint público HTTPS da Evolution API
	//   EVOLUTION_API_KEY, EVOLUTION_INSTANCE_NAME, FORECAST_GROUP_JID
	//   WEBHOOK_AUTH_TOKEN  → obrigatório em produção (sem ele o webhook
	//                         responde 503); mesmo valor no header da
	//                         instância da Evolution
	//   TARGET_PHONE_NUMBER → número do bot, só dígitos (menções nativas);
	//                         secret para não expor o número no repo
	"observability": {
		"enabled": true
	}
}
